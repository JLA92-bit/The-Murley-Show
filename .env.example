# Copy to .env and fill in.
# The public HTTPS address phones use. QR codes on the TV point here.
PUBLIC_URL=https://play.example.com
PORT=8443
DATA_DIR=./data
CONTENT_DIR=./content

# PIN for the TV /admin pages (creator dashboard, Song Lab, settings)
ADMIN_PIN=1234

# Optional: YouTube Data API v3 key so Song Lab can search YouTube (links work without it)
YOUTUBE_API_KEY=

# Optional: lets /admin generate question packs for Hard Hat Quiz (never used during a game)
ANTHROPIC_API_KEY=
